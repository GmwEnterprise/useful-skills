#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_DIR="$(dirname "$SCRIPT_DIR")/packages/pptx"

ORIGINAL_PWD="$(pwd)"

if [ $# -lt 2 ]; then
    echo "Usage: pptx-updater <pptx_file> <changes.json> [output.pptx]"
    echo ""
    echo "Arguments:"
    echo "  pptx_file    - Path to the source PowerPoint file (.pptx)"
    echo "  changes.json - JSON file describing update operations"
    echo "  output.pptx  - Optional: output path (default: <source>_updated.pptx)"
    exit 1
fi

PPTX_FILE="$1"
CHANGES_FILE="$2"
OUTPUT_FILE="${3:-}"

if [[ "$PPTX_FILE" != /* ]]; then
    PPTX_FILE="$ORIGINAL_PWD/$PPTX_FILE"
fi

if [[ "$CHANGES_FILE" != /* ]]; then
    CHANGES_FILE="$ORIGINAL_PWD/$CHANGES_FILE"
fi

if [ -n "$OUTPUT_FILE" ] && [[ "$OUTPUT_FILE" != /* ]]; then
    OUTPUT_FILE="$ORIGINAL_PWD/$OUTPUT_FILE"
fi

cd "$PACKAGE_DIR"

if ! command -v uv &> /dev/null; then
    echo "Error: uv is not installed. Please install uv first:" >&2
    echo "  curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
    exit 1
fi

uv sync --quiet

uv run python updater.py "$PPTX_FILE" "$CHANGES_FILE" ${OUTPUT_FILE:+"$OUTPUT_FILE"}
